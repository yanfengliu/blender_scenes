# Local dependencies and generated output.
.venv/
.tools/
output/
outputs/
renders/
screenshots/

# Images stay local, including render passes and working artwork.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.bmp
*.tif
*.tiff
*.tga
*.exr
*.hdr
*.heic
*.heif
*.svg
*.ico
*.psd
*.xcf

# Blender scenes and numbered save backups.
*.blend
*.blend[0-9]*
*.blend@

# Debug output and crash reports; keep source/configuration JSON trackable.
debug/
.debug/
*.log
*.log.*
*.trace
*.dmp
*.stackdump
debug-*.json
debug_*.json

# Scratch work, temporary files, caches, and editor backups.
.task-tmp/
scratch/
.scratch/
scratch.*
scratch-*
scratch_*
tmp/
.tmp/
temp/
.temp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
*.swp
*.swo
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
optix*cache.db*
